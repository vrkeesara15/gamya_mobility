# Server
NODE_ENV=development
PORT=8080
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:5000,http://localhost:8000

# Database (PostgreSQL)
DATABASE_URL=postgresql://gamya:gamya@localhost:5433/gamya_mobility?schema=public

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
ADMIN_BOOTSTRAP_EMAIL=admin@gamya.com
ADMIN_BOOTSTRAP_PASSWORD=Admin@123

# Storage: "local" (dev) or "gcs"
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=uploads
GCS_BUCKET=
GCS_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Face verification: "mock" (default) or "vision"
FACE_VERIFY_DRIVER=mock
FACE_MATCH_THRESHOLD=0.75

# Push notifications (Firebase Cloud Messaging) – optional
FCM_ENABLED=false
# FIREBASE_SERVICE_ACCOUNT_JSON=
